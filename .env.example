# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0

# REQUIRED: Admin Credentials
# Generate a secure password and set these values
# DO NOT use default values in production
ADMIN_EMAIL=admin@zenvixtotal.local
ADMIN_PASSWORD=change_me_to_secure_password

# REQUIRED: Secret Key
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your_secret_key_here_min_32_chars_recommended

# Optional: Server Configuration
PORT=5000

# REQUIRED in Production: CORS Origins
# Comma-separated list of allowed origins for Socket.IO
# Example: https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
